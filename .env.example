# ==============================================================================
# AquaSat AI: Environment Configuration Template
# Copy this file to .env and supply appropriate production secrets.
# NEVER commit raw .env files with credentials to version control.
# ==============================================================================

# Application Environment ('development' | 'production')
ENVIRONMENT=production

# Security & Session Authentication
# Generate a strong 64-character secret: openssl rand -hex 32
SECRET_KEY=your-secure-random-64-character-production-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cookie Security
SESSION_COOKIE_NAME=aquasat_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Database Configuration (PostgreSQL in production, SQLite default in local dev)
# PostgreSQL connection format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://aquasat_user:your_secure_db_password@localhost:5432/aquasat_db

# Deep Learning Inference Configuration
MODEL_INPUT_SIZE=128
DECISION_THRESHOLD=0.5

# Server Port & Host
PORT=8000
HOST=0.0.0.0
